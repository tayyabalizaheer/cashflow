{
  "name": "cash-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cash Flow personal finance PWA monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @cash-flow/api\" \"npm run dev --workspace @cash-flow/web\"",
    "build": "npm run build --workspaces",
    "build:deploy": "npm run build --workspace @cash-flow/shared && npm run build --workspace @cash-flow/web && npm run build --workspace @cash-flow/api",
    "start": "npm run start --workspace @cash-flow/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "db:migrate": "npm run prisma:migrate --workspace @cash-flow/api",
    "db:seed": "npm run prisma:seed --workspace @cash-flow/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,css}": "prettier --write"
  }
}
