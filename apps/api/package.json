{
  "name": "@cash-flow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/with-database-url.mjs prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/with-database-url.mjs prisma generate && vitest run",
    "prisma:generate": "node scripts/with-database-url.mjs prisma generate",
    "prisma:migrate": "node scripts/with-database-url.mjs prisma migrate deploy",
    "prisma:migrate:dev": "node scripts/with-database-url.mjs prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "openapi": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "argon2": "^0.43.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.5",
    "node-cron": "^4.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.2.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
