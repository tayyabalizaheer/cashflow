generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(uuid())
  fullName              String
  email                 String                   @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  failedLoginCount      Int                      @default(0)
  lockedUntil           DateTime?
  termsAcceptedAt       DateTime
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?
  preferences           UserPreference?
  refreshSessions       RefreshSession[]
  verificationTokens    EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  categories            ExpenseCategory[]
  expenses              Expense[]
  loans                 Loan[]
  loanRepayments        LoanRepayment[]
  investments           Investment[]
  assets                Asset[]
  exchangeRates         ExchangeRate[]
  zakatCalculations     ZakatCalculation[]
  zakatPayments         ZakatPayment[]
  auditEvents           AuditEvent[]
  syncOutbox            SyncOutbox[]
}

model UserPreference {
  id           String          @id @default(uuid())
  userId       String          @unique
  baseCurrency String          @default("USD")
  locale       String          @default("en-US")
  timeZone     String          @default("UTC")
  theme        String          @default("system")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  familyId           String
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  revokedAt          DateTime?
  replacedByTokenId  String?
  reuseDetectedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  userId      String
  name        String
  color       String    @default("#047857")
  icon        String    @default("circle")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@unique([userId, name])
  @@index([userId, active])
}

model Expense {
  id            String          @id @default(uuid())
  userId        String
  categoryId    String
  purpose       String
  amount        Decimal
  currency      String
  expenseDate   DateTime        @default(now())
  notes         String?
  paymentMethod String?
  recurring     Boolean         @default(false)
  frequency     String?
  receiptName   String?
  receiptUrl    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([userId, expenseDate])
  @@index([userId, currency])
  @@index([userId, categoryId])
}

model Loan {
  id            String          @id @default(uuid())
  userId        String
  person        String
  purpose       String
  amount        Decimal
  currency      String
  direction     String
  loanDate      DateTime        @default(now())
  dueDate       DateTime?
  status        String          @default("ACTIVE")
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments    LoanRepayment[]

  @@index([userId, loanDate])
  @@index([userId, status])
  @@index([userId, currency])
}

model LoanRepayment {
  id          String    @id @default(uuid())
  userId      String
  loanId      String
  amount      Decimal
  currency    String
  paymentDate DateTime  @default(now())
  notes       String?
  adjustment  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan        Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([userId, loanId])
  @@index([userId, paymentDate])
}

model Investment {
  id                  String    @id @default(uuid())
  userId              String
  type                String
  name                String?
  amountInvested      Decimal
  currency            String
  quantity            Decimal?
  nav                 Decimal?
  currentValue        Decimal?
  purchaseDate        DateTime?
  latestValuationDate DateTime?
  notes               String?
  zakatEligible       Boolean   @default(false)
  zakatPercentage     Decimal   @default(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, currency])
  @@index([userId, purchaseDate])
}

model Asset {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  assetType           String    @default("Other")
  value               Decimal
  currency            String
  acquisitionDate     DateTime?
  valuationDate       DateTime?
  zakatEligible       Boolean   @default(false)
  zakatPercentage     Decimal   @default(100)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assetType])
  @@index([userId, currency])
  @@index([userId, valuationDate])
}

model ExchangeRate {
  id           String   @id @default(uuid())
  userId       String
  baseCurrency String
  quoteCurrency String
  rate         Decimal
  source       String
  rateDate     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseCurrency, quoteCurrency, rateDate])
  @@index([userId, rateDate])
}

model ZakatCalculation {
  id                    String                 @id @default(uuid())
  userId                String
  calculationDate       DateTime
  yearLabel             String
  method                String                 @default("Configurable standard method")
  rate                  Decimal                @default(0.025)
  nisabBasis            String
  nisabThreshold        Decimal
  currency              String
  goldSilverPrice       Decimal?
  priceSource           String?
  priceDate             DateTime?
  totalZakatableWealth  Decimal
  thresholdMet          Boolean
  estimatedZakatDue     Decimal
  breakdown             Json
  disclaimerAcceptedAt  DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  archivedAt            DateTime?
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 ZakatCalculationItem[]
  payments              ZakatPayment[]

  @@index([userId, calculationDate])
  @@index([userId, currency])
}

model ZakatCalculationItem {
  id              String           @id @default(uuid())
  userId          String
  calculationId   String
  kind            String
  sourceEntityId  String?
  label           String
  amount          Decimal
  currency        String
  included        Boolean          @default(true)
  eligibilityPct  Decimal          @default(100)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  calculation     ZakatCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([userId, calculationId])
  @@index([userId, kind])
}

model ZakatPayment {
  id             String           @id @default(uuid())
  userId         String
  calculationId  String?
  amount         Decimal
  currency       String
  paymentDate    DateTime
  recipient      String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculation    ZakatCalculation? @relation(fields: [calculationId], references: [id], onDelete: SetNull)

  @@index([userId, paymentDate])
  @@index([userId, currency])
}

model AuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
}

model SyncOutbox {
  id                String   @id @default(uuid())
  userId            String
  clientMutationId  String   @unique
  entityType        String
  entityId          String?
  operation         String
  payload           Json
  status            String   @default("PENDING")
  lastAttemptAt     DateTime?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}
